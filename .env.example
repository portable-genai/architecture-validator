# C3 Architecture & Requirements Validator — example environment.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored).
# Every var below is consumed by config/settings.yaml via ${VAR:-default} interpolation.
# The onprem/test profile needs NONE of the GCP-specific values — only ARCH_VALIDATOR_PROFILE.

# ---------------------------------------------------------------------------
# Profile & project
# ---------------------------------------------------------------------------
# gcp | local | platform | onprem.  Default 'local': a WORKING offline stack (SQLite FTS5
# reg-KB + deterministic LLM) that runs the whole intake pipeline with no Google Cloud and
# no API key. 'onprem' is the fail-fast migration target (exits 2 with a migration message).
ARCH_VALIDATOR_PROFILE=local

# ---------------------------------------------------------------------------
# Local profile stores (optional; empty => ~/.architecture_validator/{local,audit}.db).
# ---------------------------------------------------------------------------
ARCH_VALIDATOR_LOCAL_DB=
ARCH_VALIDATOR_LOCAL_AUDIT=

# Optional higher-fidelity local: set a Google emulator host AND install the [gcp] extra
# to route the in-process registry/store to the emulator (the google client is imported
# lazily, only on that branch; the default local path imports no google-cloud package).
# FIRESTORE_EMULATOR_HOST=localhost:8080

# GCP project id (gcp/platform profiles only).
GOOGLE_CLOUD_PROJECT=your-gcp-project

# ---------------------------------------------------------------------------
# Region is PINNED to asia-southeast1 in config/settings.yaml — not an env var.
# Do not add a region override here; residency depends on the pin.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Security / residency (gcp profile)
# ---------------------------------------------------------------------------
# Regional Cloud KMS key for CMEK (projects/.../locations/asia-southeast1/.../cryptoKeys/...)
ARCH_VALIDATOR_KMS_KEY=

# ---------------------------------------------------------------------------
# Policy engine — OPA on Cloud Run (gcp/platform profiles)
# ---------------------------------------------------------------------------
# Base URL of the OPA REST service that evaluates the rego bundle.
ARCH_VALIDATOR_OPA_URL=

# ---------------------------------------------------------------------------
# Sibling-service HTTP contracts the validator consumes (platform profile)
# ---------------------------------------------------------------------------
# C1 Compliance Assistant (reg-KB requirement text via /ask).
RSK_COMPLIANCE_URL=http://localhost:8080
# Governed File Search / KB service (A2 Enterprise KB).
KNOWLEDGE_BASE_URL=http://localhost:8082
# Control-mapping evidence packs, now served by the compliance-advisory's
# control-mapping module (same /evidence-pack route).
RSK_CONTROL_MAPPING_URL=http://localhost:8080
# Residency scan findings (best-effort grounding signal).
RSK_RESIDENCY_URL=http://localhost:8088
# A3 registry and A5 observability/audit.
AGENT_REGISTRY_URL=http://localhost:8083
OBSERVABILITY_URL=http://localhost:8085

# ---------------------------------------------------------------------------
# Identity & embedding surface (see docs/embedding-and-identity.md)
# ---------------------------------------------------------------------------
# IAP audience (the exact structured protected-resource path) verified in gcp/platform.
# Required in secure mode: with this unset the IAP adapter refuses to verify (401).
ARCH_VALIDATOR_IAP_AUDIENCE=
# Explicit CORS origin allowlist for the cross-origin / standalone case (comma-separated;
# never "*"). Same-origin reverse-proxy embedding needs no CORS.
# THREE states, so this line stays commented out to keep the unset default: unset => the
# localhost dev origins under a deliberately chosen local profile and nothing otherwise;
# set and empty => no origin is trusted at all; set => exactly the origins named.
# ARCH_VALIDATOR_CORS_ORIGINS=
# CSP frame-ancestors: parent origins allowed to iframe the UI (space-separated). Set on
# BOTH the backend (this) and the UI (NEXT_PUBLIC_FRAME_ANCESTORS).
# THREE states, so this line stays commented out to keep the unset default: unset => 'self';
# set and empty => 'none' (nobody may frame it); set => exactly the parent origins named.
# ARCH_VALIDATOR_FRAME_ANCESTORS=

# ---------------------------------------------------------------------------
# Agent Runtime (set AFTER you deploy the reasoningEngine)
# ---------------------------------------------------------------------------
ARCH_VALIDATOR_AGENT_ENGINE=

# ---------------------------------------------------------------------------
# Optional: point at a non-default settings file.
# ---------------------------------------------------------------------------
# ARCH_VALIDATOR_SETTINGS=config/settings.yaml
